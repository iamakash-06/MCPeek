{
  "name": "mcpeek",
  "version": "1.2.0",
  "description": "Source-code-level security scanner for MCP (Model Context Protocol) server implementations",
  "type": "module",
  "bin": {
    "mcpeek": "./dist/cli.js"
  },
  "main": "./dist/scanner.js",
  "exports": {
    ".": "./dist/scanner.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "scanner",
    "sast",
    "audit",
    "vulnerability",
    "static-analysis",
    "sarif",
    "ts-morph"
  ],
  "author": "Akash Sathish <sathishakash2003@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/iamakash-06/MCPeek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamakash-06/MCPeek.git"
  },
  "bugs": {
    "url": "https://github.com/iamakash-06/MCPeek/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
